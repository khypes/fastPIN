# ============ BACKEND (Vercel: backend loyihasi Environment Variables) ============
NODE_ENV=production

# PostgreSQL (Neon / Supabase / Vercel Postgres). SSL talab qilinadi: ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Kamida 32 belgi, tasodifiy. Generatsiya: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan: https://a.vercel.app,https://fastpin.uz
FRONTEND_URL=https://fastpin.vercel.app
# Backend'ning o'z ommaviy manzili (CoinDrop webhook uchun), oxirida / yo'q
PUBLIC_API_URL=https://fastpin-api.vercel.app

# Telegram
TELEGRAM_BOT_TOKEN=
# Webhook uchun maxfiy kalit (A-Z a-z 0-9 _ -), 32+ belgi. openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_ID=

# CoinDrop (provayder)
COINDROP_BASE_URL=https://api.coindrop.io
COINDROP_API_KEY=
COINDROP_WEBHOOK_SECRET=

# Ixtiyoriy kesh (Upstash Redis). Berilmasa kesh o'chiq, ilova baribir ishlaydi.
REDIS_URL=

# FAQAT lokal development (productionda ishlatilmaydi, endpoint o'chiq)
# DEV_CONFIRM_SECRET=

# ============ FRONTEND (Vercel: frontend loyihasi Environment Variables) ============
# Backend API manzili, /api bilan tugaydi
VITE_API_URL=https://fastpin-api.vercel.app/api
